# Created automatically by the Windows Initializer. You may edit paths later.
PORT=8765
WORKER_ACCESS_KEY=replace-with-a-long-random-key
MASTER_WORKBOOK=%USERPROFILE%\OneDrive - Diehl's Truck World\Documents\VIN In-Service Checker\VIN_Master_Data.xlsx
ALLOWED_ORIGINS=https://diehl-vin-platform.vercel.app,http://localhost:3000

# Installed DTNA Sales Order + AUTO VIN automation.
DTNA_SYNC_COMMAND=python dtna_login_and_sync.py

# Optional per-VIN lookup hook. This receives DIEHL_VINS, DIEHL_RESULT_FILE,
# DIEHL_WORKER_SLOT and DIEHL_BROWSER_PROFILE environment variables.
VIN_LOOKUP_COMMAND=

# Optional Outlook/OneDrive indexing hook.
OUTLOOK_SYNC_COMMAND=
